node_modules
dist
target
dist-release
.env*

# Local tooling state, never part of the source tree

# Local [patch] pointing Cargo at a core checkout on this machine. It rewrites
# Cargo.lock, so it must never be committed and never be present for a release
# build; build-release-local.ps1 refuses to run while it exists.
.cargo/config.toml

# Playwright run artifacts; the committed baselines live in e2e/*-snapshots
test-results/
playwright-report/

# Internal working documents (audits, drafts, business notes)
private/

# Git history archives
*.bundle

# The browser extension's native host, copied here by build-release-local.ps1
# for Tauri to bundle and sign as an externalBin. A build product.
src-tauri/binaries/
