<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for the macOS build, used with macos/embedded.provisionprofile
  (Developer ID, team J3YBNT5RQ3, valid to 2044).

  Why this exists at all: the Touch ID key lives in the data protection
  keychain (Location::DataProtectionKeychain in the core's enclave backend),
  and that keychain refuses an app which carries no keychain access group:
  enrolment fails with errSecMissingEntitlement (-34018) even though the
  signature itself is valid. On macOS a keychain access group is a
  restricted entitlement, so the provisioning profile that grants it must
  travel inside the app, and the application identifier must match it.

  Deliberately nothing else in here. The app needs no JIT, loads no unsigned
  plugins, bundles no external binaries, and touches no camera, microphone
  or location. Every entitlement is an attack surface and a thing to
  justify, so the list stays at what breaks without it.
-->
<plist version="1.0">
<dict>
  <key>com.apple.application-identifier</key>
  <string>J3YBNT5RQ3.com.silentsilo.desktop</string>
  <key>com.apple.developer.team-identifier</key>
  <string>J3YBNT5RQ3</string>
  <key>keychain-access-groups</key>
  <array>
    <string>J3YBNT5RQ3.com.silentsilo.desktop</string>
  </array>
</dict>
</plist>
